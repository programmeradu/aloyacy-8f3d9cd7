{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": { "simulator": true, "resourceClass": "m-medium" },
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://app.aloya.cy",
        "EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY": "REPLACE_WITH_ANDROID_MAPS_KEY"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "resourceClass": "m-medium" },
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://app.aloya.cy",
        "EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY": "REPLACE_WITH_ANDROID_MAPS_KEY"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": { "resourceClass": "m-medium" },
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://app.aloya.cy",
        "EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY": "REPLACE_WITH_ANDROID_MAPS_KEY"
      }
    }

  },
  "submit": {
    "production": {
      "ios": {
        "language": "en-US",
        "appleId": "REPLACE_WITH_APPLE_ID_EMAIL",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./store/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "preview": {
      "ios": {
        "appleId": "REPLACE_WITH_APPLE_ID_EMAIL",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./store/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
