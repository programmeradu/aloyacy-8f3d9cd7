# Copy to mobile/.env and fill in. Never commit the filled-in file.
# EXPO_PUBLIC_* values are inlined into the client bundle — use HTTP-referrer
# restricted keys only.
EXPO_PUBLIC_API_BASE=https://app.aloya.cy
EXPO_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_TRACKING_ID=
# Android native Maps SDK key, injected by mobile/app.config.js.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# --- Payments -----------------------------------------------------------
# "live" switches Aloya Pro to live billing; anything else stays sandbox.
EXPO_PUBLIC_STRIPE_ENV=sandbox
