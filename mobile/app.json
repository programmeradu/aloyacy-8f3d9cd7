{
  "expo": {
    "name": "Aloya",
    "slug": "aloya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aloya",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cy.aloya.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification", "location"],
        "NSLocationWhenInUseUsageDescription": "Aloya uses your location to show nearby stops and live walking ETAs.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Aloya uses your location to deliver on-trip alerts (board, alight, missed bus) even when the screen is off.",
        "NSCameraUsageDescription": "Aloya uses the camera only while you scan your Motion bus card so we can read the number, name, and expiry printed on it. No images are stored."
      }
    },
    "android": {
      "package": "cy.aloya.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3A7B8A",
          "defaultChannel": "trip-alerts"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Aloya uses the camera only while you scan your Motion bus card.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
