{
  "expo": {
    "name": "Aloya",
    "slug": "aloya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aloya",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/0fa01088-812a-4d3e-b487-32fa9ca55cdb",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cy.aloya.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:app.aloya.cy",
        "applinks:aloyacy.live",
        "applinks:www.aloyacy.live",
        "applinks:app.aloyacy.live"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Aloya uses your location to show nearby stops and live walking ETAs.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Aloya uses your location to deliver on-trip alerts (board, alight, missed bus) even when the screen is off.",
        "NSCameraUsageDescription": "Aloya uses the camera only while you scan your Motion bus card so we can read the number, name, and expiry printed on it. No images are stored.",
        "NSUserTrackingUsageDescription": "Aloya uses this only to measure which features help Cyprus riders catch the bus on time. You can decline and the app works the same."
      }
    },
    "android": {
      "package": "cy.aloya.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA",
        "android.permission.CAMERA",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "app.aloya.cy", "pathPrefix": "/group/" },
            { "scheme": "https", "host": "app.aloya.cy", "pathPrefix": "/plan/" },
            { "scheme": "https", "host": "aloyacy.live", "pathPrefix": "/group/" },
            { "scheme": "https", "host": "aloyacy.live", "pathPrefix": "/plan/" },
            { "scheme": "https", "host": "www.aloyacy.live", "pathPrefix": "/group/" },
            { "scheme": "https", "host": "www.aloyacy.live", "pathPrefix": "/plan/" },
            { "scheme": "https", "host": "app.aloyacy.live", "pathPrefix": "/group/" },
            { "scheme": "https", "host": "app.aloyacy.live", "pathPrefix": "/plan/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [{ "scheme": "aloya" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3A7B8A",
          "defaultChannel": "trip-alerts"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Aloya uses the camera only while you scan your Motion bus card.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Aloya uses this only to measure which features help Cyprus riders catch the bus on time. You can decline and the app works the same."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dda858b2-7bf5-4983-9613-4960e7425b4f"
      }
    },
    "owner": "algorithmxx"
  }
}
