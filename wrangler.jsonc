{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "r2_buckets": [
    {
      "binding": "DATA_LAKE",
      "bucket_name": "aloya-data-lake"
    }
  ],
}
