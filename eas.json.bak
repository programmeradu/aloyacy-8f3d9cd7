{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_BUILD_WORKINGDIR": "mobile"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EAS_BUILD_WORKINGDIR": "mobile"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EAS_BUILD_WORKINGDIR": "mobile"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
