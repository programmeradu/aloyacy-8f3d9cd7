# Copy to .env and fill in. Nothing here is committed — .env is gitignored.
#
# Generate the secrets first:
#   JWT_SECRET               openssl rand -base64 48 | tr -d '\n'
#   POSTGRES_PASSWORD        openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
#   REALTIME_ENC_KEY         openssl rand -hex 16          (must be exactly 32 chars)
#   REALTIME_SECRET_KEY_BASE openssl rand -base64 48 | tr -d '\n'
#   DASHBOARD_PASSWORD       openssl rand -base64 24
#
# Then mint ANON_KEY and SERVICE_ROLE_KEY from JWT_SECRET with:
#   bun deploy/supabase/mint-keys.ts

# --- Core secrets -------------------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=3600

# Signed with JWT_SECRET above. These are what the app sends as `apikey`.
ANON_KEY=
SERVICE_ROLE_KEY=

# --- Public addressing --------------------------------------------
# The public HTTPS URL of the Kong service. This exact value becomes
# CUSTOM_SUPABASE_URL in the app. No trailing slash.
SUPABASE_PUBLIC_URL=https://db.aloya.cy

# Where GoTrue sends riders after email confirmation / OAuth.
SITE_URL=https://app.aloya.cy
ADDITIONAL_REDIRECT_URLS=https://app.aloya.cy/**,https://aloya.cy/**,https://www.aloyacy.live/**,https://aloyacy.lovable.app/**,aloya://**

# --- Data API ------------------------------------------------------
PGRST_DB_SCHEMAS=public,storage,graphql_public

# --- Realtime ------------------------------------------------------
REALTIME_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

# --- Outbound mail --------------------------------------------------
# Aloya sends sign-in codes through its own Resend path, so GoTrue's SMTP
# is only the fallback for confirmations. Resend SMTP relay works fine:
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_SENDER_NAME=aloyacy
SMTP_ADMIN_EMAIL=noreply@stauniverse.tech

# --- Google sign-in --------------------------------------------------
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# --- Studio dashboard login -------------------------------------------
DASHBOARD_USERNAME=aloya
DASHBOARD_PASSWORD=
