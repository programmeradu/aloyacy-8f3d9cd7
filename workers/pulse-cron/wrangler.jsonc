{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aloya-pulse-cron",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": {
    "crons": [
      "* * * * *",
      "*/15 * * * *",
      "*/30 * * * *",
      "17 * * * *",
      "0 3 * * *",
      "17 9 * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "DATA_LAKE",
      "bucket_name": "aloya-data-lake"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://app.aloya.cy",
    "CUSTOM_SUPABASE_URL": "https://mjyvihhgwtqpltbddits.supabase.co",
    "CUSTOM_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1qeXZpaGhnd3RxcGx0YmRkaXRzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc1ODIyMTYsImV4cCI6MjEwMzE1ODIxNn0.a-yBLBpeczw2BGEvxzk6Z2eWK3hYoAGtPNgGZzqMl2w",
    "CUSTOM_SUPABASE_SERVICE_ROLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1qeXZpaGhnd3RxcGx0YmRkaXRzIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NzU4MjIxNiwiZXhwIjoyMTAzMTU4MjE2fQ.lA3dDhu8u25Vj1leoMD1LTisa2JRiwHGYlhVFuHp02A"
  }
}
