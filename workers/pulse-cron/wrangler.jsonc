{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aloya-pulse-cron",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": {
    "crons": [
      "* * * * *",
      "*/15 * * * *",
      "*/30 * * * *",
      "17 * * * *",
      "0 3 * * *",
      "17 9 * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "DATA_LAKE",
      "bucket_name": "aloya-data-lake"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://app.aloya.cy",
    "CUSTOM_SUPABASE_URL": "https://fofxzpjmpozdnkoqkojc.supabase.co",
    "CUSTOM_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZvZnh6cGptcG96ZG5rb3Frb2pjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc1NjM4MTUsImV4cCI6MjEwMzEzOTgxNX0.7r-9CPkkb9BuOEA14c89zTRqCmA7wYqtJzv39ehC-hg",
    "CUSTOM_SUPABASE_SERVICE_ROLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZvZnh6cGptcG96ZG5rb3Frb2pjIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NzU2MzgxNSwiZXhwIjoyMTAzMTM5ODE1fQ.AiiOwZRL2EFkh0kT9uuTp1YvCv_NWR-hmLj_YeT00xU"
  }
}
