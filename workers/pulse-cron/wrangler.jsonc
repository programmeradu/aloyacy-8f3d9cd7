{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aloya-pulse-cron",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": {
    "crons": [
      "* * * * *",
      "*/15 * * * *",
      "*/30 * * * *",
      "17 * * * *",
      "0 3 * * *",
      "17 9 * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "DATA_LAKE",
      "bucket_name": "aloya-data-lake"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://app.aloya.cy",
    "CUSTOM_SUPABASE_URL": "https://xbidevhyloeetxfjdjiy.supabase.co"
  }
}
