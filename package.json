{
  "name": "aloya",
  "version": "1.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Aloya — transit companion for Cyprus: live arrivals, trip planning and journey guidance across web and mobile.",
  "sideEffects": false,
  "keywords": [
    "cyprus",
    "public-transport",
    "gtfs",
    "gtfs-realtime",
    "trip-planning",
    "tanstack-start",
    "expo"
  ],
  "docs": {
    "architecture": "ARCHITECTURE.md",
    "contributing": "CONTRIBUTING.md",
    "commitPolicy": "docs/COMMIT_POLICY.md",
    "commercial": "COMMERCIAL.md",
    "changelog": "CHANGELOG.md",
    "dependencyAudit": "docs/DEPENDENCY_AUDIT.md"
  },
  "operations": {
    "health": "/api/public/health",
    "metrics": "/api/public/metrics",
    "logger": "src/lib/logger.ts",
    "errorTracking": "src/lib/error-tracking.ts",
    "logFormat": "json-lines (pino-compatible shape, custom Worker-safe implementation)",
    "errorTrackingProtocol": "sentry-envelope",
    "schemas": "src/lib/schemas/public-api.ts"
  },
  "type": "module",
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "packages/*",
    "mobile"
  ],
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "sharp",
    "tesseract.js",
    "workerd"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "bun install && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "check:env": "node scripts/check-env-parity.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:validation": "node scripts/input-validation-report.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mobile": "vitest run --config vitest.mobile.config.ts",
    "test:mobile:coverage": "vitest run --config vitest.mobile.config.ts --coverage",
    "test:all": "bun run test && bun run test:mobile",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aloya/core": "workspace:*",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@lovable.dev/email-js": "^0.0.4",
    "@lovable.dev/mcp-js": "^0.20.0",
    "@lovable.dev/webhooks-js": "^0.0.1",
    "@mapbox/polyline": "^1.2.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.12",
    "@resvg/resvg-wasm": "^2.6.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@stripe/react-stripe-js": "6.2.0",
    "@stripe/stripe-js": "9.2.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.9.3",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "input-otp": "^1.4.2",
    "jose": "^6.2.3",
    "lucide-react": "^0.575.0",
    "mapillary-js": "^4.1.2",
    "nitro": "3.0.260603-beta",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-email": "^6.5.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "stripe": "22.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tesseract.js": "^7.0.0",
    "ts-morph": "^28.0.0",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.25.5",
    "@eslint/js": "^10.0.1",
    "@lovable.dev/vite-tanstack-config": "2.22.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/router-plugin": "^1.167.28",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/google.maps": "^3.64.1",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^26.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.7.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.3.0",
    "vitest": "^5"
  }
}
