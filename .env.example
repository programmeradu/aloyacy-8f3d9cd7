# Aloya — environment template. Copy to `.env` and fill in what you need.
# `.env*` is gitignored: never commit real values.
#
# The app boots with none of these set — bundled static GTFS still renders
# stops, routes and timetables. Each block below unlocks one capability.

# --- Database (self-hosted Supabase / Postgres) ----------------------
# Server-side reads. Same values, VITE_-prefixed, reach the browser client.
CUSTOM_SUPABASE_URL=
CUSTOM_SUPABASE_ANON_KEY=
VITE_CUSTOM_SUPABASE_URL=
VITE_CUSTOM_SUPABASE_ANON_KEY=
# Legacy alias for CUSTOM_SUPABASE_URL, still read by /api/public/health.
SUPABASE_URL=
# Privileged writes (ingest, cron, admin RPCs). Server only — never VITE_.
# Fallback name accepted by /api/public/health when CUSTOM_SUPABASE_ANON_KEY is unset.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CUSTOM_SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps Platform --------------------------------------------
# Server key: Routes, Directions, Places, Street View metadata.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BACKUP_KEY=
GOOGLE_MAPS_CONNECTION_ID=
# Browser key (HTTP-referrer restricted): Maps JavaScript SDK.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=

# --- Cloudflare R2 Data Lake -----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Live GTFS-Realtime ------------------------------------------------
# Cloudflare relay that fronts the upstream feed (workers/gtfs-relay).
GTFS_RELAY_URL=
GTFS_RELAY_TOKEN=

# --- Scheduled jobs -----------------------------------------------------
# Shared secret required by /api/public/snapshot and other cron endpoints.
CRON_SECRET=

# --- Transactional email + sign-in codes --------------------------------
RESEND_API_KEY=
RESEND_DIRECT_API_KEY=
AUTH_EMAIL_FROM=
AUTH_EMAIL_FROM_FALLBACK=
CF_EMAIL_FROM=

# --- Web push (departure + disruption alerts) ----------------------------
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Payments (Aloya Pro) -------------------------------------------------
VITE_PAYMENTS_CLIENT_TOKEN=
STRIPE_API_KEY=
STRIPE_SECRET_KEY=

# --- Google Wallet passes ---------------------------------------------------
GOOGLE_WALLET_ISSUER_ID=
# Full service-account JSON, single line.
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# --- Optional enrichment & Direct AI ------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
MAPILLARY_ACCESS_TOKEN=
ELEVENLABS_API_KEY=
LOVABLE_API_KEY=

LOVABLE_SEND_URL=
SEMRUSH_API_KEY=
FIRECRAWL_API_KEY=
DATEX_CY_URL=
DATEX_CY_AUTH=

# --- Error tracking ------------------------------------------------------------
# Sentry-compatible DSN. Unset = reporting is a no-op; SSR failures still land
# in the structured logs. See src/lib/error-tracking.ts.
SENTRY_DSN=

# Bearer token a Prometheus scraper must send to GET /api/public/metrics.
# Unset = the scrape endpoint is open (it exposes counter names and numbers
# only, never request data or credentials). See src/lib/metrics.ts.
METRICS_TOKEN=


# --- Mobile (Expo) --------------------------------------------------------------
# The Expo app reads its own `mobile/.env` (template: mobile/.env.example).
# Mirrored here so a fresh clone sees every variable the monorepo consumes.
# EXPO_PUBLIC_* values are inlined into the client bundle — use restricted keys.
EXPO_PUBLIC_API_BASE=https://app.aloya.cy
EXPO_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_TRACKING_ID=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_ENV=sandbox

# --- Misc ----------------------------------------------------------------------
# Canonical origin used by OG image URLs and email links.
PUBLIC_SITE_URL=http://localhost:8080
# Passphrase for the internal /qa console. Unset = console stays locked.
VITE_QA_PASSPHRASE=

# --- Self-hosted backend stack (deploy/supabase) ----------------------
# Only needed when running the Docker stack in deploy/supabase; it lives in
# deploy/supabase/.env there. Signs every API key and auth token, so reuse the
# exact value from the project you migrated from or all sessions invalidate.
JWT_SECRET=

# --- Runtime -----------------------------------------------------------------
# Set by the platform in production; listed so the template covers every name
# the code reads. Local dev leaves it unset (Vite defaults to development).
NODE_ENV=development
